    "plot_sample_size_comparisons",
    "package_timing_rows", "package_timing_summary_table",
    "plot_package_timing_histograms"
)
for (object in fixture_report_objects) {
    assign(object, get(object), envir = .GlobalEnv)
}
for (object in fixture_report_objects) {
    if (is.function(get(object, envir = .GlobalEnv))) {
        fn <- get(object, envir = .GlobalEnv)
        environment(fn) <- .GlobalEnv
        assign(object, fn, envir = .GlobalEnv)
    }
}
@

\maketitle

\noindent This report compares \textbf{bfpwr} predictions with simulations
across the listed priors, evidence thresholds, and sampling schedules.

<<registry-missing-note, results = 'asis', echo = FALSE>>=
if (!registry_available) {
    cat("\\noindent \\textbf{Note.} The verification settings were not available during this render, so the detailed settings tables are omitted.\n\n")
}
@

<<family-sections, results = 'asis', echo = FALSE, fig.height = 6.8, fig.width = 6.8, out.width = "\\textwidth">>=
if (registry_available) for (family in names(family_labels)) {
    if (family != "z") cat("\\clearpage\n")
    cat("\\section{", family_labels[[family]], "}\n", sep = "")

    cat("\\subsection*{Simulated Design Priors}\n")
    latex_table(design_table(family),
                caption = paste("Simulated design priors for the",
                                gsub("\\\\textit\\{|\\}", "", family_labels[[family]]),
                                "verification run. The Design column gives short IDs used by the analysis-prior table."))

    cat("\\subsection*{Analysis Priors}\n")
    latex_table(analysis_prior_table(family),
                caption = paste("Analysis priors used for the",
                                gsub("\\\\textit\\{|\\}", "", family_labels[[family]]),
                                "verification run. Designs lists the matching short IDs from the design-prior table."))
    if (family == "z" && !is.null(one_sided)) {
        cat("\\noindent Normal($\\mu$, $\\sigma$) uses mean $\\mu$ and SD $\\sigma$ before truncation. Subscripts $+$ and $-$ denote truncation above and below zero; a nonzero cutoff is shown explicitly. Normal design priors remain untruncated.\\par\n")
    }

    if (family == "t") cat("\\clearpage\n")
    cat("\\subsection{Fixed-Design}\n")
    fixed_setup <- fixture_setup_table(family, "fixed")
    latex_table(fixed_setup,
                caption = paste("Fixed-design verification settings for",
                                gsub("\\\\textit\\{|\\}", "", family_labels[[family]]),
                                "analyses. Designs refers to the design-prior table."), keep_together = TRUE)
    mat_fixed <- materialized_fixture_specs(family, "fixed")
    if (!corpus_available) {
        cat("\\noindent Simulation results unavailable; fixed-design figures are not rendered.\n\n")
    } else if (length(mat_fixed) == 0) {
        cat("\\noindent No fixed-design results are available for this statistical test.\n\n")
    } else {
        for (spec in mat_fixed) {
            plot_fixed_fixture(spec)
        }
    }

    if (family == "binomial") next

    cat("\\subsection{Sequential-Design}\n")
    sequential_setup <- fixture_setup_table(family, "sequential")
    latex_table(sequential_setup,
                caption = paste("Sequential-design verification settings for",
                                gsub("\\\\textit\\{|\\}", "", family_labels[[family]]),
                                "analyses. Designs refers to the design-prior table."), keep_together = TRUE)
    if (family == "z" && !is.null(one_sided)) {
        cat("\\begin{samepage}\\noindent The Normal$_{+}$ and Normal$_{-}$ cases use a single look at 300, three equally spaced looks (100, 200, 300), three uneven looks (20, 100, 300), and 50 looks from 10 to 500. For the centered prior with SD 0.707 and point design priors at 0 and 0.2, schedules also contain 100 or 200 looks in steps of 10. BF 10/3 and BF 3/10 denote asymmetric stopping thresholds $(k_1,k_0)=(1/10,3)$ and $(1/3,10)$.\\par\\end{samepage}\n")
    }
    mat_seq <- materialized_fixture_specs(family, "sequential")
    if (!corpus_available) {
        cat("\\noindent Simulation results unavailable; sequential-design figures are not rendered.\n\n")
    } else if (length(mat_seq) == 0) {
        cat("\\noindent No sequential-design results are available for this statistical test.\n\n")
    } else {
        if (family == "t") {
            cat("\\noindent The sequential \\textit{t}-test probabilities use a normal approximation to the sampling distribution of the test statistics.\\par\n")
        }
        for (spec in mat_seq) {
            plot_sequential_fixture(spec)
        }
    }
}
@

\clearpage
\section{Sample-Size Search Checks}

\noindent The searches cover \texttt{nbf01} with one-sided Normal priors,
\texttt{nbf01seq}, and \texttt{ntbf01seq}. They compare the first sample sizes at
which simulated and computed probabilities of evidence for H1 or H0 reach a
target. Sequential sample sizes refer to the maximum planned sample size.
Only finite results from both methods enter the figures.

\noindent Left panels compare sample sizes. Right panels compare computed and
simulated probabilities at the package solution, expressed in Monte Carlo SEs,
with reference lines at $\pm 2$ and $\pm 3$ SEs. For fixed designs, the package
solution is rounded up to the simulation grid for the probability comparison.

\subsection{Fixed-Design z-Test: \texttt{nbf01}}

\noindent These comparisons cover the 70 Normal$_{+}$ and Normal$_{-}$
analysis-prior/design-prior combinations listed in the z-test section. Targets
are 0.8 and 0.9 for both H1 and H0, with BF thresholds 3, 10, and 30 and a search
range from 10 to 500. The package searches over integer sample sizes; simulated
probabilities are available every 10 observations.

<<fixed-search-comparison, results = 'asis', echo = FALSE, error = FALSE, fig.height = 3.8, fig.width = 6.8, out.width = "\\textwidth">>=
search_rows <- sample_size_comparisons()
if (nrow(search_rows) == 0L) {
    cat("\\noindent Sample-size search results are not available.\\par\n")
} else {
    plot_sample_size_comparisons(search_rows, "fixed")
}
@

\clearpage
\subsection{Sequential z-Test: \texttt{nbf01seq}}

\noindent The normal and point priors, normal moment priors, and directional
hypotheses use 15, 20, and 15 searches, respectively, with the analysis and design
priors listed in the z-test section. Targets are 0.1, 0.3, and 0.8 for all three
models, and 0.95 for directional hypotheses. BF thresholds are 3, 10, and 30 for
H1 and H0. Looks occur every 10 observations starting at 10 or 20. Upper search
bounds depend on the scenario and extend to 2,000 for normal and directional
models and 1,000 for moment priors.

\noindent The one-sided normal cases use Normal$_{+}$(0, 0.707),
Normal$_{-}$(0, 0.707), Normal$_{+}$(0.2, 0.3), and Normal$_{-}$(0.2, 0.3), all
seven generating distributions, and targets 0.8 and 0.9 for H1 and H0. These 112
searches use $(k_1,k_0)=(1/10,10)$ and looks from 10 to 500 in steps of 10.

<<sequential-z-search-comparisons, results = 'asis', echo = FALSE, error = FALSE, fig.height = 3.8, fig.width = 6.8, out.width = "\\textwidth">>=
if (nrow(search_rows) > 0L) {
    for (model in c("normal", "moment", "directional")) {
        plot_sample_size_comparisons(search_rows, "sequential", model)
    }
}
@

\clearpage
\subsection{Sequential t-Test: \texttt{ntbf01seq}}

\noindent The 26 searches use Cauchy and StudentT analysis priors with two-sided,
greater, and less alternatives, and point and Normal design priors. Sampling is
one-sample, paired, or two-sample, with two-sample allocation ratios 1 and 1.1.
Targets are 0.1, 0.3, 0.8, and 0.95, with BF thresholds 3, 10, and 30 for H1 and
H0. Looks occur every 10 observations starting at 10 or 20, and upper search
bounds range from 30 to 2,000. Two-sample sizes refer to group 1.
For allocation ratio 1.1, group-2 sizes are rounded to the nearest integer in
the simulation and upward in the package search.
The sequential t probabilities use a normal approximation to the sampling
distribution of the test statistics.

<<sequential-t-search-comparisons, results = 'asis', echo = FALSE, error = FALSE, fig.height = 3.8, fig.width = 6.8, out.width = "\\textwidth">>=
if (nrow(search_rows) > 0L) {
    plot_sample_size_comparisons(search_rows, "sequential", "t")
}
@

\clearpage
\section{Run Time Diagnostics}

\noindent Elapsed times are recorded for the package calculations shown above. Fixed-design probability calls can cover several rows
at once because those functions are vectorized; most sequential and sample-size
search calls are one setting at a time.

<<package-call-timing-section, results = 'asis', echo = FALSE, fig.height = 8.5, fig.width = 7.5>>=
if (report_workers > 1L) {
    cat("\\noindent Calculations used ", report_workers,
        " concurrent workers.\\par\n", sep = "")
}
timing_summary <- package_timing_summary_table()
if (nrow(timing_summary) == 0) {
    cat("\\noindent Run time results are unavailable.\n\n")
} else {
    latex_table(timing_summary,
                caption = paste(
                    "Probability and sample-size search run times.",
                    "Fixed probability rows can be vectorized, so calls and",
                    "rows covered need not match."), keep_together = TRUE)
    if (!is.null(one_sided)) {
        timings <- rbind(
            data.frame(Function = ifelse(one_sided$timings$operation == "fixed",
                                         "pbf01", "pbf01seq"),
                       seconds = one_sided$timings$seconds),
            data.frame(Function = ifelse(one_sided$searches$mode == "fixed",
                                         "nbf01", "nbf01seq"),
                       seconds = one_sided$searches$seconds))
        directional_timings <- do.call(rbind, lapply(
            split(timings, timings$Function), function(x) {
                data.frame(Function = x$Function[1], "Timed runs" = nrow(x),
                    Median = fmt_seconds(median(x$seconds)),
                    P90 = fmt_seconds(as.numeric(quantile(x$seconds, 0.9))),
                    Max = fmt_seconds(max(x$seconds)),
                    Total = fmt_seconds(sum(x$seconds)), check.names = FALSE)
            }))
        latex_table(directional_timings,
            caption = paste("One-sided z-test run times.",
                "Each fixed pbf01 run times the H1 and H0 vector calls together;",
                "each other run times one package call."), keep_together = TRUE)
    }
    cat("\\clearpage\n")
    cat("\\noindent Histograms show the calls in the probability and sample-size search timing table.\\par\n")
    plot_package_timing_histograms()
}
@

\end{document}
